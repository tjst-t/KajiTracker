{
  "name": "kajitracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "deploy": "CLOUDFLARE_ENV=production npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "bootstrap-link": "node scripts/bootstrap-link.mjs",
    "e2e": "node e2e/login-flow.mjs && node e2e/chores-flow.mjs && node e2e/bulk-grid-flow.mjs && node e2e/stats-flow.mjs && node e2e/push-flow.mjs",
    "e2e:pwa": "node e2e/pwa-flow.mjs",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "vapid:generate": "node scripts/vapid-generate.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-datasheet-grid": "^4.11.6",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "react-resize-detector": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}

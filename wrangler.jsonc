{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kajitracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kajitracker",
      // 本番の D1 を作ったら、その id に置き換える（ローカルではこのままで動く）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 当日の通知：15分ごとに起こす（docs/design.md の 3）
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // 画面のオリジン（カンマ区切り）。パスキーの RP ID はそのホスト名。
    // 本番は "https://kaji.tjstkm.net" だけにする。開発で公開 URL を足すときは .dev.vars で上書きする
    "ORIGINS": "http://localhost:5173"
  },
  // Web Push の鍵。ローカルは .dev.vars、本番は wrangler secret put で入れる（README）
  "secrets": { "required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"] },
  "observability": { "enabled": true },
  // 本番（https://kaji.tjstkm.net）。`npm run deploy` は CLOUDFLARE_ENV=production でビルドしてから出す。
  // 上の設定はローカルとテスト用（ローカルの D1 は上の database_id で場所が決まるので、変えない）
  "env": {
    "production": {
      "name": "kajitracker",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kajitracker",
          "database_id": "09bfa015-113f-458f-ac02-fbbd43bed36f",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": { "ORIGINS": "https://kaji.tjstkm.net" },
      "routes": [{ "pattern": "kaji.tjstkm.net", "custom_domain": true }],
      "workers_dev": false
    }
  }
}
